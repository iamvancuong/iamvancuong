# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — CỐ Ý commit .next để deploy qua `git pull` (server shared hosting
# không build được vì glibc cũ). Chỉ bỏ cache/dev vì nặng và tự tái tạo.
/.next/cache
/.next/dev
/out/

# gói build tạm (nén để upload thủ công — không commit)
*.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ============================================================
# DỮ LIỆU CÁ NHÂN — repo này public, PLAN §12
# Không bao giờ commit những thứ dưới đây.
# ============================================================

# Backup JSON của Life OS (tiền, journal, sức khỏe, giấy tờ)
/backup/
*.os-backup.json

# Ảnh giấy tờ, visa, 在留カード, hợp đồng
/private/
public/images/private/

# Ghi chú cá nhân không định xuất bản
content/private/


# Prisma
/generated

# Ảnh đã upload — file thật, không đưa vào git
/uploads

# Danh sách ngày do dữ liệu mẫu tạo — máy nào cũng khác
prisma/.demo-days.json

# File kích hoạt restart của Passenger — do deploy.sh tạo TRÊN SERVER.
# Lọt vào git là lần `git pull` sau chết với "untracked working tree files
# would be overwritten by merge", vì server đã có sẵn file này dạng untracked.
/tmp/
