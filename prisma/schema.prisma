// Life OS — schema. Xem docs/OS-DESIGN.md
//
// Nguyên tắc: LĨNH VỰC nằm trong dữ liệu, không nằm trong code.
// Thêm một lĩnh vực mới = INSERT một dòng Area, không sửa dòng code nào.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: chuỗi kết nối không còn khai báo ở đây nữa.
// Migration đọc từ prisma.config.ts, còn lúc chạy thì lib/db.ts truyền adapter.
datasource db {
  provider = "mysql"
}

/// Lĩnh vực của cuộc sống. Tiếng Nhật, Công việc, Tình yêu, Gia đình...
model Area {
  id      String  @id @default(cuid())
  slug    String  @unique // "tieng-nhat"
  name    String // "Tiếng Nhật"
  tagline String? @db.Text // câu hỏi mà lĩnh vực này trả lời
  icon    String? // tên icon lucide
  order   Int     @default(0)
  active  Boolean @default(true) // tạm ẩn mà không xóa dữ liệu

  goals      Goal[]
  principles Principle[]
  items      Item[]
  memories   Memory[]
  photos     Photo[]
  focusItems FocusItem[]
  metrics    Metric[]
  studyGoals StudyGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Mốc thời gian của mục tiêu.
///
/// Hai nhóm khác hẳn nhau về bản chất, cố ý để chung một bảng vì chúng đều
/// là "điều tôi muốn đạt ở lĩnh vực này":
///
///   WEEK · MONTH        CAM KẾT CÓ KỲ. Thuộc về đúng một tuần/tháng cụ thể
///                       (xem periodStart), hết kỳ thì chấm kết quả rồi đóng
///                       lại. Tuần sau là một cam kết mới, không phải cái cũ.
///   THIS_YEAR … LIFE    MỐC DÀI HẠN. Không có ngày kết thúc, sống cùng mình
///                       nhiều tháng tới nhiều năm.
///
/// Thứ tự khai báo cũng là thứ tự sắp xếp trong MySQL — gần nhất lên trước.
enum Horizon {
  WEEK // cam kết một tuần — dùng kèm periodStart
  MONTH // cam kết một tháng — dùng kèm periodStart
  THIS_YEAR
  NEXT_YEAR
  AGE // dùng kèm horizonAge: 25, 30...
  LIFE // cả đời
}

enum GoalStatus {
  NOT_STARTED
  DOING
  DONE
  DROPPED // bỏ đúng lúc là kỹ năng — nhớ ghi lý do vào dropReason
}

/// Kết quả của một cam kết SAU KHI hết kỳ.
///
/// Tách khỏi GoalStatus vì đây là hai câu hỏi khác nhau: status trả lời "đang
/// làm tới đâu", outcome trả lời "kỳ đó rốt cuộc thế nào". Có PARTIAL vì phần
/// lớn tuần thật nằm ở giữa — ép về đúng/sai chỉ khiến người ta ngại chấm.
enum GoalOutcome {
  SUCCESS
  PARTIAL
  FAILED
}

model Goal {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  title  String
  detail String? @db.Text
  why    String? @db.Text // vì sao việc này quan trọng với mình

  horizon    Horizon
  horizonAge Int? // chỉ dùng khi horizon = AGE

  /// Ngày đầu kỳ — CHỈ dùng khi horizon = WEEK hoặc MONTH.
  /// Tuần: thứ Hai của tuần đó. Tháng: ngày 1.
  /// Luôn là nửa đêm UTC như mọi cột @db.Date khác (lib/os/day.ts).
  periodStart DateTime? @db.Date

  /// Cách đo. Để trống nếu mục tiêu không đo được bằng số.
  metric String?
  target String?
  current String?

  status     GoalStatus @default(NOT_STARTED)
  dropReason String?    @db.Text
  doneAt     DateTime?

  /// ---- Tự sự sau khi hết kỳ ----
  /// Phần có giá trị nhất của cam kết tuần. Bản thân việc đạt hay không đạt
  /// một tuần thì ít nghĩa; biết VÌ SAO mới đổi được tuần sau.
  /// Ba câu giống hệt nhật ký ngày, để khỏi phải học thêm khung tư duy mới.
  outcome    GoalOutcome?
  reviewWhat String?      @db.Text // chuyện gì đã xảy ra
  reviewWhy  String?      @db.Text // điều gì khiến mình đạt / không đạt
  reviewNext String?      @db.Text // kỳ sau đổi gì
  reviewedAt DateTime?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, status])
  @@index([horizon, periodStart])
}

enum PrincipleKind {
  DO // nên
  DONT // không nên
}

/// Nguyên tắc sống. KHÔNG phải to-do — không tick hằng ngày.
/// Đây là thứ để đọc lại lúc đang phân vân.
model Principle {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  kind PrincipleKind
  text String        @db.Text
  why  String?       @db.Text

  active Boolean @default(true)
  /// Ghim để hiện ở Dashboard /os (một nguyên tắc mỗi ngày xoay vòng qua các
  /// nguyên tắc ĐƯỢC GHIM). Mặc định tắt: chỉ cái được tick mới lên trang chủ.
  pinned Boolean @default(false)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, kind])
}

enum ItemStatus {
  USING // đang dùng
  DROPPED // đã bỏ  ← phần có giá trị nhất
  WANT // muốn thử
}

/// Thứ đang dùng: skincare, dầu gội, quần áo, giáo trình, khóa học, công cụ.
model Item {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  name  String
  kind  String? // "skincare" | "tóc" | "quần áo" | "sách"... nhập tự do
  status ItemStatus @default(WANT)

  startedAt DateTime?
  endedAt   DateTime?
  cost      Int? // ¥

  /// Kết luận sau khi dùng. Ô quan trọng nhất — để 6 tháng sau
  /// khỏi mua lại thứ từng vô dụng.
  verdict String? @db.Text
  note    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, status])
}

/// Chiều nào là tốt lên. Cần biết mới tô được màu đúng:
/// cân nặng tăng có thể là tốt, chi tiêu tăng thì không.
enum MetricDirection {
  UP // càng cao càng tốt — điểm thi, số bài đã viết
  DOWN // càng thấp càng tốt — chi tiêu, cân nặng khi đang giảm
}

/// Số đo — một con số có tên, ghi lại theo thời gian.
///
/// Đây là câu trả lời chung cho ba thứ từng định làm thành ba module riêng:
/// điểm mock test JLPT, cân nặng, chi tiêu hằng tháng. Cùng một hình dạng dữ
/// liệu, nên cùng một bộ code — đúng nguyên tắc ở OS-DESIGN §1.
///
/// PLAN §9 chống ảo tưởng tiến bộ: neo vào số đo được thật (điểm thang JLPT
/// 60/60/60), đừng dùng "Vocabulary 72%" — phần trăm của cái gì thì không ai
/// biết. Bảng này tồn tại để chỗ ghi con số thật đó có mặt.
model Metric {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  name      String // "điểm mock N3"
  unit      String? // "/180" · "kg" · "¥"
  target    String? // "≥ 95" — để chữ vì có khi là khoảng, không phải một số
  direction MetricDirection @default(UP)
  note      String?         @db.Text

  /// Nhóm số đo TRONG một lĩnh vực: "JLPT" · "Trên lớp" · "Ra thị trường".
  ///
  /// Chuỗi tự do, cùng khuôn với `Item.kind` — site một người dùng thì một
  /// bảng riêng kèm CRUD riêng không đáng (OS-DESIGN §1). Đánh đổi là gõ sai
  /// chính tả sinh nhóm trùng; đã chấp nhận đánh đổi đó ở `Item.kind` rồi.
  ///
  /// Tác dụng chính KHÔNG phải gọn mắt mà là **nói rõ cái gì không so được
  /// với cái gì**: điểm thi thử thang /180 mỗi tháng và điểm kiểm tra trên lớp
  /// mỗi tuần để chung một chỗ thì mắt sẽ tự so hai đường, mà so là vô nghĩa.
  ///
  /// Để trống = rơi vào nhóm "Chưa phân nhóm", luôn xếp cuối.
  group String?

  entries MetricEntry[]

  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, active])
}

/// Một lần ghi. Ngày chứ không phải thời điểm — cùng quy ước nửa đêm UTC với
/// mọi cột @db.Date khác (lib/os/day.ts).
model MetricEntry {
  id       String @id @default(cuid())
  metricId String
  metric   Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  value Float
  note  String?  @db.Text

  createdAt DateTime @default(now())

  /// Một ngày một giá trị — ghi lại cùng ngày là đè lên, không tạo dòng thứ hai.
  @@unique([metricId, date])
  @@index([metricId, date])
}

/// Chu kỳ của một khoản chi cố định.
enum CostCycle {
  MONTH
  YEAR // quy về tháng bằng cách chia 12 — bảo hiểm, phí gia hạn tên miền...
}

/// Chi phí cố định lặp lại: tiền nhà, điện thoại, bảo hiểm, vé tàu tháng.
///
/// Vì sao KHÔNG gộp vào `DailyLog.spend`: những khoản này không phải quyết
/// định hằng ngày. Ghi chúng vào ngày bị trừ tiền sẽ làm tháng đó trông như
/// một tháng tiêu hoang, trong khi thứ thật sự đáng nhìn — mình tiêu bao nhiêu
/// vào những thứ CHỌN được — lại bị chôn dưới tiền nhà.
///
/// Chia đôi như vậy thì tổng tháng vẫn đúng, mà vẫn trả lời được câu hỏi khác
/// hẳn: "sàn cố định mỗi tháng của mình là bao nhiêu, và cần bao nhiêu tháng
/// sàn đó để thành quỹ khẩn cấp?"
model FixedCost {
  id     String    @id @default(cuid())
  name   String
  amount Int // ¥ mỗi kỳ
  cycle  CostCycle @default(MONTH)
  note   String?   @db.Text

  /// Khoảng còn hiệu lực. `endedAt` null = vẫn đang trả.
  /// Có hai cột này thì tháng 3 năm ngoái vẫn tính đúng theo hợp đồng hồi đó,
  /// thay vì lấy giá hiện tại áp ngược cho cả quá khứ.
  startedAt DateTime? @db.Date
  endedAt   DateTime? @db.Date

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Một tháng tài chính. Chỉ giữ thứ KHÔNG suy ra được từ chỗ khác.
///
/// Chi tiêu không nằm ở đây: nó cộng từ `DailyLog.spend` + `FixedCost`. Chỉ
/// thu nhập là con số phải tự khai, vì hệ thống không có cách nào biết.
model MonthBudget {
  id String @id @default(cuid())

  /// Ngày 1 của tháng, nửa đêm UTC — cùng quy ước với mọi cột @db.Date khác.
  month DateTime @unique @db.Date

  income Int? // ¥ thực nhận
  note   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

enum Visibility {
  PRIVATE // mặc định — chỉ mình xem
  PUBLIC // đã tick "cho người khác xem"
}

/// Ký ức. Ngày tự do nên lùi được về tận tuổi thơ ở Quảng Trị.
/// Vừa là nhật ký riêng, vừa là nguyên liệu cho blog.
model Memory {
  id     String  @id @default(cuid())
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// Ngày CHUYỆN XẢY RA, không phải ngày nhập.
  /// @db.Date (không giờ) — ký ức thuộc về một ngày, không phải một thời điểm.
  /// Luôn dựng bằng nửa đêm UTC, nếu không múi giờ JST sẽ đẩy lùi một ngày.
  date    DateTime @db.Date
  title   String
  body    String?  @db.Text
  learned String?  @db.Text
  place   String?
  people  String? // đi với ai

  visibility Visibility @default(PRIVATE)
  photos     Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([visibility, date])
}

/// Ảnh — database chỉ giữ ĐƯỜNG DẪN. File thật nằm ở object storage.
/// Nhồi ảnh vào MySQL sẽ làm backup chậm và không có CDN.
model Photo {
  id  String @id @default(cuid())
  url String @db.Text // bản đầy đủ (WebP)
  thumbUrl String? @db.Text // bản nhỏ cho trang lưới
  width  Int?
  height Int?
  bytes  Int?

  caption String?   @db.Text
  takenAt DateTime?

  /// Thứ tự ảnh TRONG một ký ức. Focus sắp xếp được từ lâu, ảnh thì chưa —
  /// nên tấm đại diện của một ký ức là tấm tình cờ up trước, không phải tấm
  /// đáng nhìn nhất. Hai nút lên/xuống, cùng cách với `reorderFocusItem`.
  order Int @default(0)

  memoryId String?
  memory   Memory? @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  postId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  visibility Visibility @default(PRIVATE)

  createdAt DateTime @default(now())

  @@index([visibility, takenAt])
  @@index([memoryId])
}

enum FocusStatus {
  NOW // trần cứng 3 — ràng buộc quan trọng nhất của hệ thống
  NEXT
  LATER
  NO // chủ động không làm
}

model FocusItem {
  id    String @id @default(cuid())
  title String

  /// Khóa ngoại thật, không phải chuỗi rời. Trước đây đây là String? trần —
  /// xóa một lĩnh vực để lại con trỏ chết và giao diện im lặng bỏ qua.
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  status FocusStatus @default(NEXT)
  why    String?     @db.Text

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([areaId])
}

/// Chỉ số hằng ngày. Cố tình nhỏ — 3 thói quen nền tảng, không phải 20.
model DailyLog {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date

  sleepAt String? // "23:40"

  /// Số hiệp pomodoro tiếng Nhật đã xong hôm nay. 1 hiệp = POMO_MIN phút
  /// (lib/os/constants.ts). Đây là cách ghi giờ học CHÍNH: tick một ô ở /os.
  ///
  /// ⚠️ CỘT NÀY LÀ BẢN SAO. Nguồn thật là số dòng `PomoSession` của ngày đó —
  /// mỗi hiệp một dòng, vì mỗi hiệp còn phải nhớ nó thuộc mảng nào (từ vựng /
  /// nghe / đọc…). Giữ thêm bản sao ở đây để mọi thống kê cũ (chuỗi, lịch
  /// nhiệt, cảnh báo tuần) chỉ cần đọc `DailyLog` như trước, không phải nối
  /// bảng ở mười chỗ.
  ///
  /// Bất biến: `jpPomo == số dòng PomoSession cùng ngày`. Giữ được vì **chỉ
  /// `setPomodoro()` được phép ghi cột này**, và nó ghi cả hai trong cùng một
  /// transaction. Đừng thêm đường ghi thứ hai — form nhật ký cố ý KHÔNG còn
  /// nhận `jpPomo` nữa, nó dùng chính hàng ô đó.
  jpPomo Int @default(0)

  /// Phút tiếng Nhật **LẺ, ngoài pomodoro** — nghe podcast trên tàu, nói
  /// chuyện, xem phim. KHÔNG phải tổng.
  ///
  /// Vì sao tách khỏi `jpPomo` thay vì suy ngược `pomo = jpMin / 50`: gõ tay
  /// 35 phút sẽ làm hàng ô tick nhảy loạn, và bỏ tick một ô sẽ xóa mất chính
  /// số phút vừa gõ. Hai cột rời nghĩa nhau thì không bao giờ đếm hai lần.
  ///
  /// ⚠️ Tổng giờ tiếng Nhật của một ngày = `jpTotal(log)` trong
  /// lib/os/japanese.ts. KHÔNG đọc thẳng `jpMin` ở bất cứ chỗ thống kê nào.
  jpMin Int @default(0)

  itMin Int  @default(0)
  spend Int? // ¥

  /// Phút BỎ VÀO CHÍNH TRANG NÀY hôm nay.
  ///
  /// Tách khỏi `itMin` vì hai thứ khác hẳn nhau: `itMin` là học IT — có ích cho
  /// mục tiêu việc làm; `webMin` là xây công cụ để quản lý việc học — thứ cho
  /// CẢM GIÁC tiến bộ mà không đẩy mục tiêu nào đi.
  ///
  /// `buildingTooMuch()` xưa nay so `itMin` với `jpMin`, tức là nó phạt nhầm
  /// việc học IT và hoàn toàn mù trước việc ngồi code cái web này — đúng thứ
  /// nó sinh ra để bắt. Cột này là cảm biến thật của cảnh báo đó.
  webMin Int @default(0)

  kSleep    Boolean @default(false) // ngủ trước 00:00
  kJapanese Boolean @default(false) // tiếng Nhật ≥ 60 phút
  kEat      Boolean @default(false) // ăn đủ 3 bữa
  workout   Boolean @default(false)

  journalWhat   String? @db.Text
  journalLearn  String? @db.Text
  journalChange String? @db.Text

  /// Đáng viết thành bài — cuối tuần lọc ra
  publishable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// Việc phải làm của ĐÚNG MỘT NGÀY. "Ôn bài 2,3 · từ vựng bài 5".
///
/// `date` là **ngày phải làm**, không phải ngày viết. Nhờ vậy 12 giờ đêm ngồi
/// viết cho mai thì sáng mai mở /os là nó đã nằm sẵn ở tab «Hôm nay» — không
/// phải chép, không phải nhắc.
///
/// Vì sao KHÔNG dùng `FocusItem`: Focus là tầm tuần–tháng và trần cứng 3 dòng,
/// sai tầm cho một danh sách việc trong ngày.
/// Vì sao KHÔNG dùng một ô text trong `DailyLog`: cần tick được từng việc.
/// Vì sao KHÔNG đưa vào /os/calendar: lịch ở đây cố ý không có ô giờ và không
/// có sự kiện (STATE.md §8) — Google Calendar là nguồn duy nhất cho hẹn giờ.
model DayTask {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  title String
  done  Boolean  @default(false)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// Một đợt học có kỳ hạn và có NHỊP MỖI NGÀY. "N3 trong 4 tháng, 7 hiệp/ngày".
///
/// Vì sao không nhét vào `Goal`: `Goal` chỉ có `horizon` (tuần/tháng/tuổi) —
/// nó không có khoảng ngày→ngày, cũng không có nhịp mỗi ngày, mà một mục tiêu
/// kiểu này cần đủ cả hai để trả lời được câu "hôm nay tôi đang nhanh hay
/// chậm". Trộn vào sẽ phải thêm ba cột chỉ đúng hai giá trị horizon dùng tới.
///
/// Đặt mục tiêu khác sau này (N2 trong 6 tháng, 5 hiệp/ngày) = **thêm một
/// dòng**, không sửa dòng code nào — cùng nguyên tắc với `Area`.
///
/// Nguồn giờ hiện là pomodoro tiếng Nhật (`DailyLog.jpPomo`). Muốn đo lĩnh vực
/// khác thì thêm một cột `source` và một nhánh trong `lib/os/japanese.ts`;
/// chưa làm vì chưa có lĩnh vực thứ hai nào đang bấm giờ.
model StudyGoal {
  id     String  @id @default(cuid())
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  name String // "JLPT N3"
  note String? @db.Text

  /// Cùng quy ước nửa đêm UTC với mọi cột @db.Date khác (lib/os/day.ts).
  startDate  DateTime @db.Date
  targetDate DateTime @db.Date

  /// Nhịp: bao nhiêu hiệp pomodoro mỗi ngày thì tới đích.
  dailyPomo Int @default(7)

  /// Chỉ MỘT mục tiêu đang chạy được hiện ở /os. Xong đợt thì tắt, không xóa —
  /// đợt cũ còn để nhìn lại mình từng cam kết nhịp nào.
  active Boolean @default(true)

  skills StudySkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, targetDate])
}

/// Một mảng kỹ năng trong đợt, có NGÂN SÁCH GIỜ riêng.
///
///     🇯🇵 Từ vựng + Kanji   250h
///     📖 Ngữ pháp           150h
///     🎧 Nghe               150h
///     📚 Đọc                150h
///     📝 Đề N3 + chữa lỗi   100h
///     🗣️ Kaiwa/shadowing     75h
///
/// Vì sao là bảng chứ không phải sáu cột: sáu mảng này là kế hoạch cho **N3**.
/// Đợt N2 sẽ chia khác (thêm 語彙 học thuật, bỏ shadowing…), mà sáu cột cứng
/// thì đổi kế hoạch là phải sửa schema. Ở đây đổi kế hoạch = sửa dữ liệu.
///
/// `targetHours` là GIỜ chứ không phải hiệp: chủ nhân nghĩ bằng giờ ("250h"),
/// còn hiệp chỉ là cách bấm. Quy đổi ở lib/os/japanese.ts, một chỗ duy nhất.
model StudySkill {
  id          String    @id @default(cuid())
  studyGoalId String
  studyGoal   StudyGoal @relation(fields: [studyGoalId], references: [id], onDelete: Cascade)

  name        String // "Từ vựng + Kanji"
  icon        String? // emoji — nhận ra bằng mắt nhanh hơn đọc chữ
  targetHours Int     @default(0)

  sessions PomoSession[]

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studyGoalId, order])
}

/// MỘT hiệp pomodoro = MỘT dòng.
///
/// Vì sao không phải một con số đếm trong `DailyLog`: một con số không nhớ
/// được hiệp đó học **mảng nào**, mà đó chính là thứ cần để biết "từ vựng đã
/// đi được 62/250 giờ". Đổi từ đếm sang dòng SAU KHI có dữ liệu thật là phải
/// viết script suy đoán ngược — không suy được, vì thông tin chưa từng được
/// ghi. Nên phải là dòng ngay từ đầu.
///
/// `skillId` cho phép null: bấm một hiệp mà chưa kịp nghĩ nó thuộc mảng nào
/// vẫn phải ghi được. Giờ đó vẫn vào tổng, chỉ không vào mảng nào cả — và
/// giao diện nói thẳng là "chưa gắn mảng" thay vì im lặng nuốt mất.
model PomoSession {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  skillId String?
  skill   StudySkill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  /// Thứ tự trong ngày, 1..POMO_SLOTS. Có nó thì bỏ hiệp là bỏ đúng hiệp cuối.
  order Int @default(0)

  createdAt DateTime @default(now())

  @@index([date])
  @@index([skillId])
}

/// Chủ đề bài viết. Nằm trong dữ liệu chứ không hard-code trong lib/site.ts,
/// nên tạo chủ đề mới ngay lúc viết bài là được — trang /blog tự có thêm
/// bộ lọc tương ứng, không phải sửa code.
model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  order Int    @default(0)
  posts Post[] @relation("PostTags")

  createdAt DateTime @default(now())
}

/// Blog. Cùng một kho cho bài công khai và bài riêng tư —
/// khác nhau đúng một trường.
model Post {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  excerpt String? @db.Text
  body    String  @db.LongText
  tags    Tag[]   @relation("PostTags")

  /// Bản tiếng Nhật. Null = bài chưa có bản tiếng Nhật,
  /// route /blog/[slug]/ja sẽ không tồn tại.
  titleJa String?
  bodyJa  String? @db.LongText

  visibility  Visibility @default(PRIVATE)
  publishedAt DateTime?

  photos Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visibility, publishedAt])
}

/// Tin nhắn từ form liên hệ ở trang chủ công khai. Chỉ LƯU (chưa có hạ tầng
/// gửi mail); chủ nhân đọc qua Prisma Studio hoặc trang /os sau này.
model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  message String  @db.Text
  ip      String?
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
}
